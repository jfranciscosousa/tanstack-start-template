{
  "name": "tanstack-start-template",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "prepare": "husky",
    "dev": "bun scripts/run.ts scripts/dev.ts",
    "browser:auth": "bun scripts/run.ts scripts/browser-auth.ts",
    "build": "bun scripts/run.ts scripts/build.ts",
    "build:prod": "bun run db migrate && bun run build",
    "start": "bun scripts/run.ts scripts/start.ts",
    "clean": "bun scripts/run.ts scripts/clean.ts",
    "lint": "bun scripts/run.ts scripts/lint.ts",
    "format": "bun scripts/run.ts scripts/format.ts",
    "ts-check": "bun scripts/run.ts scripts/ts-check.ts",
    "test": "bun scripts/run.ts scripts/test.ts",
    "test:vitest": "bun scripts/run.ts scripts/test.vitest.ts",
    "test:e2e": "bun scripts/run.ts scripts/test.e2e.ts",
    "test:e2e:setup": "bun scripts/run.ts scripts/test.e2e.setup.ts",
    "test:scripts": "vitest run scripts --project happy-dom",
    "test:skills": "vitest run scripts/skills-update.test.ts --project happy-dom",
    "db": "bun scripts/run.ts scripts/db.ts",
    "db:reset": "bun scripts/run.ts scripts/db.reset.ts",
    "ci": "bun scripts/run.ts scripts/ci.ts",
    "setup": "bun scripts/run.ts scripts/setup.ts",
    "skills:update": "bun scripts/run.ts scripts/skills-update.ts",
    "validate-env": "bun scripts/run.ts scripts/validate-env.ts",
    "worktree": "bun scripts/run.ts scripts/worktree.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "1.0.0-rc.2-203eab8",
    "evlog": "^2.35.1",
    "lucide-react": "^1.70.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.261103-rc",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "varlock": "^1.24.0",
    "zod": "^4.6.7",
    "zod-form-data": "^3.0.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@opentelemetry/api": "^1.10.0",
    "@playwright/test": "^1.65.0",
    "@shadcn/lint": "^0.2.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@varlock/vite-integration": "^1.5.5",
    "@vitejs/plugin-react": "6.2.1",
    "drizzle-kit": "1.0.0-rc.2-203eab8",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxc-transform-react": "^0.157.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-plugin-react-doctor": "^0.9.22",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vitest-mock-extended": "^5.1.1"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "source-map-js": "1.2.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "bun run oxfmt --no-error-on-unmatched-pattern",
      "bun run oxlint --fix"
    ],
    "*.{json,md,css}": [
      "bun run oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "core-js-pure",
    "esbuild",
    "msw",
    "nitro"
  ]
}
