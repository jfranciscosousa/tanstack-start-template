# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# Single-project Varlock setup at the repo root.
# Environment selection: APP_ENV drives @currentEnv, defaulting to Vercel's
# VERCEL_ENV when deployed on Vercel, otherwise development.
# Precedence: .env.schema < .env < .env.local < .env.[APP_ENV] < .env.[APP_ENV].local
# Process overrides always win (e.g. APP_ENV=production, DATABASE_URL=...).
#
# @currentEnv=$APP_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# Blob baked into the server bundle (resolved-env mode) is encrypted in
# preview/production. Set _VARLOCK_ENV_KEY (sensitive) on the platform for
# build AND runtime - generate with `varlock generate-key`.
# @encryptInjectedEnv=forEnv(preview, production)
# ----------

# --- Environment selection ---

# Vercel-injected environment name (development | preview | production).
# Empty locally. See https://vercel.com/docs/environment-variables#system-environment-variables
# @optional @type=enum(development, preview, production)
VERCEL_ENV=

# Canonical environment flag. Derives from Vercel when deployed, defaults to
# development locally. Override per command, e.g. APP_ENV=test pnpm test.
# @required @type=enum(development, test, preview, production)
APP_ENV=fallback($VERCEL_ENV, development)

# Standard Node environment flag, kept for tooling compat (Vite, Vitest,
# scripts/helpers/env.ts which loads .env vs .env.test). Aligns with APP_ENV
# except preview maps to production.
# @optional @type=enum(development, test, production)
NODE_ENV=remap($APP_ENV, preview, production, test, test, undefined, development)

# --- Database ---

# Postgres connection string. No default: must come from .env / .env.test
# (written by `pnpm setup`, gitignored) or from the platform (Vercel env vars
# or a secrets manager with OIDC, no secret-zero). Local format:
# postgresql://<user>@localhost:5432/<db>_dev
# @required @sensitive @type=url(allowedProtocols=[postgres, postgresql])
# @example="postgresql://postgres:secret@localhost:5432/myapp_dev"
# @docs("Drizzle + postgres-js", https://orm.drizzle.team/docs/get-started/postgresql-new)
DATABASE_URL=

# --- Auth (better-auth) ---

# Secret used to sign better-auth sessions. Must be long and random in any
# deployed environment - generate with `openssl rand -base64 32`.
# No default: a missing secret must fail validation, never silently fall back
# to a committed placeholder. Local value comes from .env (`pnpm setup`).
# @required @sensitive @type=string(minLength=32)
# @example="openssl rand -base64 32"
# @docs("better-auth secret", https://www.better-auth.com/docs/installation#set-environment-variables)
BETTER_AUTH_SECRET=

# Public base URL of the app, used as better-auth baseURL when neither
# VERCEL_URL nor VERCEL_PROJECT_PRODUCTION_URL is set (i.e. local dev / test).
# Required in dev/test (provided by .env / .env.test via `pnpm setup`);
# undefined in preview/production, where the Vercel URL takes over.
# @required=forEnv(development, test) @type=url(noTrailingSlash=true)
# @example="http://localhost:3000"
BETTER_AUTH_URL=

# Hostname of the current deployment, injected automatically by Vercel
# (no protocol, e.g. myapp-abc123-team.vercel.app on previews).
# src/lib/auth.ts prefers this over VERCEL_PROJECT_PRODUCTION_URL so auth
# works on preview URLs, not just production.
# @optional @type=domain
VERCEL_URL=

# Production hostname, injected automatically by Vercel (no protocol,
# e.g. myapp.vercel.app). Fallback when VERCEL_URL is absent.
# @optional @type=domain
VERCEL_PROJECT_PRODUCTION_URL=

# --- Dev / build options ---

# Local dev server port (scripts/dev.ts, `pnpm dev`). Vercel/production ignore it.
# @optional @type=port
PORT=3000

# Nitro preset for the Vite build (vite.config.ts). Defaults to "vercel".
# @optional
# @example="vercel"
NITRO_PRESET=vercel

# --- CI / test runner flags (read, never set by the app) ---

# Set to "true" by CI providers. scripts/helpers/env.ts skips varlock
# auto-loading when present; scripts require .env.test locally when absent.
# @optional @type=boolean
CI=

# Set by Vitest at runtime (src/server/db/index.ts limits the pg pool to 1
# connection for per-test transaction isolation).
# @optional @type=boolean
VITEST=
