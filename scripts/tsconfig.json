{
  "include": ["**/*.ts", "**/*.mts", "../*.config.ts", "../env.d.ts"],
  "compilerOptions": {
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node", "zx/globals", "vite/client"],
    "paths": { "~/*": ["../src/*"] },
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
